{
    "standard":  "ARKNOZ_SOURCE_CONNECTOR_REGISTRY_V1",
    "scope":  "PLATFORM_WIDE",
    "purpose":  "Defines how external APIs, websites and submitted sources may contribute discovery and evidence to Arknoz without becoming the canonical data layer.",
    "core_principle":  "External systems supply evidence and discovery. Arknoz owns canonical IDs, normalized schemas, relationships, review state and presentation.",
    "ingestion_pipeline":  [
                               "RAW_SOURCE",
                               "DISCOVERY",
                               "NORMALIZATION",
                               "IDENTITY_RESOLUTION",
                               "DUPLICATE_CHECK",
                               "EVIDENCE_REVIEW",
                               "CONFLICT_CHECK",
                               "HUMAN_OR_SYSTEM_REVIEW",
                               "CANONICAL_CANDIDATE",
                               "PUBLICATION_GATE"
                           ],
    "universal_rules":  [
                            "No external API is a live dependency for an already approved Arknoz record.",
                            "External source field names are normalized into Arknoz schemas.",
                            "Original source wording and identifiers are preserved for provenance.",
                            "External IDs never replace Arknoz canonical IDs.",
                            "Duplicate evidence strengthens one claim; it does not create duplicate entities.",
                            "Conflicting values remain conflicts until reviewed.",
                            "Discovery scores are not Arknoz verification scores.",
                            "No discovery result becomes canonical automatically.",
                            "No source may overwrite stronger reviewed evidence automatically.",
                            "Public pages read from Arknoz-approved data rather than directly from external APIs.",
                            "Failure of one connector must not remove previously approved Arknoz content."
                        ],
    "connectors":  [
                       {
                           "connector_id":  "SRC-WIKIDATA",
                           "name":  "Wikidata",
                           "source_class":  "STRUCTURED_KNOWLEDGE",
