{
  "registry": "ARKNOZ_PLACEMENT_SLOT_REGISTRY",
  "version": "1.0",
  "status": "FROZEN_V1",
  "public": false,
  "purpose": "Permanent internal placement identities for canonical Arknoz records.",
  "rules": {
    "slot_ids_are_internal": true,
    "slot_ids_are_permanent": true,
    "slot_ids_are_not_public_labels": true,
    "canonical_entities_are_never_duplicated": true,
    "assignment_uses_canonical_entity_reference": true,
    "empty_slot_behavior": "hide",
    "project_compatible": true,
    "dynamic_search_and_index_results_are_not_fixed_slots": true,
    "context_templates_reuse_the_same_slot_numbers_for_each_geography": true
